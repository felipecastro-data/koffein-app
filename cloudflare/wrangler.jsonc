{
  // koffein on Cloudflare: one Worker serves the app (public/) and the API, with
  // the data in D1. Everything lives under /<APP_KEY>/ — any other path is a 404.
  "name": "koffein",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Version preview URLs would be a second way in; the key check covers them,
  // but there's no reason to have them.
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request, the page included, passes the key check in the Worker.
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "koffein",
      "database_id": "a18241ef-b434-43e3-a9c4-b1bf4655aeca",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
